[Unit]
Description=JianYuanShield edge session gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jys-gateway
Group=jys-gateway
EnvironmentFile=/etc/jys-gateway/gateway.env
ExecStart=/usr/bin/python3 /opt/JianYuanShield/runtime/gateway-986efa3.py --host 127.0.0.1 --port 18081
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
