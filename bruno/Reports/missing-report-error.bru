meta {
  name: Missing Report Error
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/reports/not-a-real-report
}

headers {
  accept: application/json
}

tests {
  test("returns 404", function() {
    expect(res.status).to.equal(404);
  });

  test("uses unified error shape", function() {
    expect(res.body.ok).to.equal(false);
    expect(res.body.error.code).to.equal("not_found");
    expect(res.body.error.path).to.equal("/api/reports/not-a-real-report");
  });
}
