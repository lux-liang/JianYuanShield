/* 开场动画 v6 · 曲面屏(球内壁感)散布 morph 人脸 + 骰子 + 强碎裂 + 音效 */
.splash {
  position: fixed; inset: 0; z-index: 9999; overflow: hidden;
  background: linear-gradient(160deg, #eef4fb 0%, #f6faff 48%, #e8eef8 100%);
  transition: opacity .4s ease;
}
.splash.out { opacity: 0; }

/* 曲面屏氛围：人脸在外围环形绕屏边缓慢漂移，中心留空（不遮挡骰子/logo）；浮动 + 噪声↔清晰闪烁 */
.dome-wrap { position: absolute; inset: 0; overflow: hidden; perspective: 1100rpx; }
.dome { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform: rotateX(7deg); animation: domedrift 80s linear infinite; }
.dtile {
  position: absolute; left: 0; top: 0; width: 300rpx; height: 380rpx;
  border-radius: 24rpx; overflow: hidden; border: 1rpx solid rgba(255, 255, 255, .55);
  box-shadow: 0 16rpx 50rpx rgba(11, 42, 69, .1); backface-visibility: hidden;
  animation: morph 5.5s ease-in-out infinite;
}
.dtile image { width: 100%; height: 100%; animation: floaty 7s ease-in-out infinite; }
@keyframes domedrift { from { transform: rotateX(7deg) rotateZ(0); } to { transform: rotateX(7deg) rotateZ(360deg); } }
@keyframes morph { 0%,100% { filter: blur(12rpx) contrast(1.7) brightness(1.15); opacity: .16; } 48% { filter: blur(0); opacity: .5; } 56% { filter: blur(0); opacity: .5; } }
@keyframes floaty { 0%,100% { transform: translateY(-10rpx); } 50% { transform: translateY(10rpx); } }

/* 全屏闪白（撞击瞬间） */
.bigflash { position: absolute; inset: 0; background: #ffffff; opacity: 0; animation: bigflash 4.3s ease-out forwards; }
@keyframes bigflash { 0%,62%{opacity:0;} 64%{opacity:.92;} 72%{opacity:0;} 100%{opacity:0;} }

/* 舞台（含撞击震屏） */
.stage { position: absolute; left: 0; right: 0; top: 42%; height: 0; perspective: 950rpx; animation: shake 4.3s linear forwards; }
@keyframes shake {
  0%,62%{ transform: translateX(0);} 63.5%{ transform: translateX(-12rpx);} 65%{ transform: translateX(12rpx);}
  66.5%{ transform: translateX(-8rpx);} 68%{ transform: translateX(6rpx);} 70%{ transform: translateX(0);} 100%{ transform: translateX(0);}
}

/* 骰子 */
.fall { position: absolute; left: 50%; top: -110rpx; width: 220rpx; height: 220rpx; margin-left: -110rpx; transform-style: preserve-3d; animation: fall 4.3s cubic-bezier(.34,1.18,.5,1) forwards; }
.cube { width: 220rpx; height: 220rpx; position: relative; transform-style: preserve-3d; animation: spin 2.3s linear infinite; }
.face { position: absolute; left: 0; top: 0; width: 220rpx; height: 220rpx; box-sizing: border-box;
  background: rgba(255,255,255,.7); border: 2rpx solid rgba(3,105,161,.4); border-radius: 26rpx; overflow: hidden;
  box-shadow: inset 0 0 40rpx rgba(56,189,248,.3), 0 10rpx 36rpx rgba(3,105,161,.2);
  display: flex; align-items: center; justify-content: center; }
.face image { width: 100%; height: 100%; }
.f1 { transform: rotateY(0deg) translateZ(110rpx); }
.f2 { transform: rotateY(90deg) translateZ(110rpx); }
.f3 { transform: rotateY(180deg) translateZ(110rpx); }
.f4 { transform: rotateY(-90deg) translateZ(110rpx); }
.f5 { transform: rotateX(90deg) translateZ(110rpx); }
.f6 { transform: rotateX(-90deg) translateZ(110rpx); }
@keyframes spin { 0%{transform: rotateX(-16deg) rotateY(0);} 100%{transform: rotateX(-16deg) rotateY(360deg);} }
@keyframes fall {
  0%{ transform: translateY(-130vh) scale(1); opacity:1;}
  13%{ transform: translateY(0) scale(1);}
  17%{ transform: translateY(-30rpx) scale(1.03);}
  21%{ transform: translateY(0) scale(1);}
  60%{ transform: translateY(0) scale(1); opacity:1;}
  64%{ transform: translateY(0) scale(1.18); opacity:1;}
  69%{ transform: translateY(0) scale(.04); opacity:0;}
  100%{ transform: translateY(0) scale(.04); opacity:0;}
}

/* 盾牌(=粒子树 logo) 砸落定格 */
.shield { position: absolute; left: 50%; top: -94rpx; width: 200rpx; height: 200rpx; margin-left: -100rpx;
  filter: drop-shadow(0 12rpx 40rpx rgba(3,105,161,.45)); animation: shieldSeq 4.3s cubic-bezier(.3,1,.5,1) forwards; opacity: 0; }
.shield image { width: 100%; height: 100%; }
@keyframes shieldSeq {
  0%{ opacity:0; transform: translateY(-130vh) scale(.7);}
  50%{ opacity:0; transform: translateY(-130vh) scale(.7);}
  60%{ opacity:1; transform: translateY(-30rpx) scale(1);}
  64%{ opacity:1; transform: translateY(0) scale(.86);}
  70%{ opacity:1; transform: translateY(-8rpx) scale(1.2);}
  100%{ opacity:1; transform: translateY(-12rpx) scale(1.24);}
}

/* 碎片爆裂 */
.shards { position: absolute; left: 50%; top: 0; }
.shard { position: absolute; left: 0; top: 0; width: 28rpx; height: 28rpx; margin-left: -14rpx; margin-top: -14rpx;
  background: linear-gradient(135deg, rgba(255,255,255,.95), rgba(186,224,250,.85));
  border: 1rpx solid rgba(3,105,161,.45); border-radius: 6rpx; opacity: 0;
  animation: burst 4.3s cubic-bezier(.2,.7,.3,1) forwards; }
@keyframes burst {
  0%,62%{ opacity:0; transform: translate(0,0) rotate(0) scale(1);}
  64%{ opacity:1; transform: translate(0,0) rotate(0) scale(1.1);}
  100%{ opacity:0; transform: translate(var(--tx), var(--ty)) rotate(var(--rot)) scale(.2);}
}

/* 标题 */
.s-title { position: absolute; left: 0; right: 0; top: 156rpx; text-align: center; font-size: 66rpx; font-weight: 800; color: #0b2a45; letter-spacing: 12rpx; }
.sc { display: inline-block; opacity: 0; }
.sc1 { animation: asm1 4.3s cubic-bezier(.2,1.2,.3,1) forwards; }
.sc2 { animation: asm2 4.3s cubic-bezier(.2,1.2,.3,1) forwards; }
.sc3 { animation: asm3 4.3s cubic-bezier(.2,1.2,.3,1) forwards; }
@keyframes asm1 { 0%,70%{opacity:0; transform: translate(-130rpx,-90rpx) rotate(-55deg) scale(.2);} 84%{opacity:1; transform: translate(0,0) rotate(0) scale(1.14);} 100%{opacity:1; transform:none;} }
@keyframes asm2 { 0%,73%{opacity:0; transform: translate(0,120rpx) rotate(42deg) scale(.2);} 86%{opacity:1; transform: translate(0,0) rotate(0) scale(1.14);} 100%{opacity:1; transform:none;} }
@keyframes asm3 { 0%,76%{opacity:0; transform: translate(130rpx,-100rpx) rotate(58deg) scale(.2);} 88%{opacity:1; transform: translate(0,0) rotate(0) scale(1.14);} 100%{opacity:1; transform:none;} }
.s-sub { position: absolute; left: 0; right: 0; top: 250rpx; text-align: center; font-size: 24rpx; color: #0369a1; letter-spacing: 4rpx; opacity: 0; animation: subSeq 4.3s ease forwards; }
@keyframes subSeq { 0%,80%{opacity:0; transform: translateY(16rpx);} 92%{opacity:1; transform: translateY(0);} 100%{opacity:1;} }

.skip-hint { position: absolute; left: 0; right: 0; bottom: calc(70rpx + env(safe-area-inset-bottom)); text-align: center; color: rgba(11,42,69,.4); font-size: 22rpx; letter-spacing: 2rpx; }
