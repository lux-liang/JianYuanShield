<splash wx:if="{{showSplash}}" bind:done="onSplashDone"></splash>

<view wx:if="{{needLogin}}" class="onboard">
  <view class="ob-card">
    <image class="ob-logo" src="/assets/logo-light.png" mode="aspectFit"></image>
    <view class="ob-title">寻源路</view>
    <view class="ob-sub">主动水印 · 已登记内容来源核验</view>
    <view class="ob-row">
      <button class="ob-avatar" open-type="chooseAvatar" bindchooseavatar="onObAvatar">
        <image src="{{tmpAvatar || '/assets/logo-light.png'}}" mode="aspectFit"></image>
      </button>
      <view class="ob-hint">点击设置头像</view>
    </view>
    <input class="ob-input" type="nickname" placeholder="请输入昵称" value="{{tmpNick}}" bindinput="onObNick" bindblur="onObNick"></input>
    <button class="btn primary ob-btn" bindtap="obSubmit">进入寻源路</button>
  </view>
</view>

<view class="cube-stage" bindtap="onTap">
  <view class="cube4" style="transform: translateZ(-375rpx) rotateY({{rot}}deg)">

    <!-- 面 0 · 来源保护 -->
    <view class="cube-face cf0">
      <scroll-view scroll-y scroll-with-animation scroll-into-view="{{scrollTo}}" class="face-scroll">
        <view class="face-pad">
          <view class="hero">
            <image class="hero-eye" src="/assets/eye.png" mode="aspectFit"></image>
            <view class="hero-head">
              <view class="hero-logo"><image src="/assets/logo-light.png" mode="aspectFit"></image></view>
              <view style="flex:1"><view class="hero-title">寻源路</view><view class="hero-sub">主动来源保护 · 已登记内容核验</view></view>
              <view class="health-dot {{health}}"><view class="dot"></view><text>{{healthText}}</text></view>
            </view>
            <view class="feature-row">
              <view class="feat"><view class="fi"><image src="/assets/tab-forensics-on.png"></image></view><text class="ft">主动水印</text></view>
              <view class="feat"><view class="fi"><image src="/assets/ic-mea.png"></image></view><text class="ft">攻击模拟</text></view>
              <view class="feat"><view class="fi"><image src="/assets/ic-history.png"></image></view><text class="ft">登记核验</text></view>
              <view class="feat"><view class="fi"><image src="/assets/tab-evidence-on.png"></image></view><text class="ft">签名审计</text></view>
            </view>
          </view>
          <view wx:if="{{apiConfigError}}" class="status err trust-strip risk">配置阻断：{{apiConfigError}}</view>

          <view class="seg" style="margin-bottom:20rpx">
            <view class="seg-item" bindtap="goMea">⚔ MEA 横评</view>
            <view class="seg-item" bindtap="goCompliance">▦ 合规能力门禁</view>
          </view>

          <view class="card">
            <text class="exhibit">Exhibit 01 · Registered Provenance</text>
            <view class="card-title">创作者来源保护 · 登记核验</view>
            <view class="card-desc">上传授权图片 → 创建保护登记 → 获取 content_id 与保护图 → 对传播图执行登记核验 → 三元可信门禁</view>
            <view class="stepper">
              <block wx:for="{{steps}}" wx:key="*this">
                <view class="step {{index < step ? 'on' : ''}}"><view class="num">{{index+1}}</view><view class="lbl">{{item}}</view></view>
                <view wx:if="{{index < steps.length-1}}" class="step-line"></view>
              </block>
            </view>
            <view class="field">
              <view class="field-label">1 · 选择图片</view>
              <view class="pick" bindtap="chooseImage">
                <image wx:if="{{imgPath}}" src="{{imgPath}}" mode="aspectFit"></image>
                <block wx:else><text class="plus">＋</text><text class="hint">点击从相册 / 拍照选择</text></block>
                <view wx:if="{{loading}}" class="gen-fx">
                  <view class="gen-grain"></view>
                  <view class="gen-shatter"></view>
                  <view class="gen-sweep"></view>
                  <view class="gen-label">{{loadingAction==='verify'?'登记核验中…':(loadingAction==='infer'?'工程评估中…':'保护登记中…')}}</view>
                </view>
              </view>
              <view style="margin-top:12rpx"><text class="badge info" bindtap="useSample">或：用内置样本</text></view>
              <view wx:if="{{isBuiltInSample}}" class="privacy-box safe">当前使用内置公开样本，不涉及个人图片。</view>
              <checkbox-group wx:else bindchange="onUploadConsent" class="privacy-box">
                <label class="privacy-check">
                  <checkbox value="accepted" checked="{{uploadConsent}}" color="#0369a1"></checkbox>
                  <text>我确认拥有该图片的处理权限，并知悉图片会上传至已配置后端，用于来源保护登记或模型工程评估。保护登记会持久化创作者标识、哈希与保护记录，原图是否留存以服务端公开策略为准。请勿上传敏感、未授权或含他人人脸的图片。</text>
                </label>
              </checkbox-group>
            </view>
            <view class="field">
              <view class="field-label">2 · 创作者标识（会写入保护登记）</view>
              <input class="ob-input" maxlength="128" placeholder="昵称、机构编号或授权主体标识" value="{{creatorRef}}" bindinput="onCreatorRef"></input>
            </view>
            <view class="field">
              <view class="field-label">3 · 水印模型</view>
              <view class="seg"><view wx:for="{{models}}" wx:key="name" class="seg-item {{model===item.name?'active':''}} {{item.provenanceReady?'':'disabled'}}" data-v="{{item.name}}" bindtap="onSelectModel"><text>{{item.name}}</text><text class="seg-reason">{{item.shortReason}}</text></view></view>
              <view class="privacy-box {{modelStatusClass}}">{{modelStatusText}}</view>
            </view>
            <button class="btn primary" disabled="{{loading || !modelReady}}" bindtap="protectContent">{{loadingAction==='protect' ? '保护登记中…' : '创建来源保护登记'}}</button>
            <view class="note">只有返回 <text class="code">real_checkpoint + claim_valid=true + registered_protection_record</text> 时，保护登记才显示“可引用”。记录创建成功并不必然代表可信门禁通过。</view>

            <view class="field" style="margin-top:28rpx">
              <view class="field-label">4 · 登记内容 ID</view>
              <input class="ob-input" maxlength="32" placeholder="保护登记返回的 32 位 content_id" value="{{contentId}}" bindinput="onContentId"></input>
            </view>
            <view class="field">
              <view class="field-label">5 · 选择待核验传播图</view>
              <view class="pick" bindtap="chooseVerifyImage" style="height:240rpx">
                <image wx:if="{{verifyImgPath}}" src="{{verifyImgPath}}" mode="aspectFit"></image>
                <block wx:else><text class="plus">＋</text><text class="hint">保护登记后自动填入保护图，或从相册选择收到的传播图</text></block>
              </view>
              <checkbox-group wx:if="{{verifyImgPath}}" bindchange="onVerifyUploadConsent" class="privacy-box">
                <label class="privacy-check">
                  <checkbox value="accepted" checked="{{verifyUploadConsent}}" color="#0369a1"></checkbox>
                  <text>我确认拥有待核验图片的处理权限，并同意上传至后端与指定 content_id 的登记水印进行核验。</text>
                </label>
              </checkbox-group>
              <view wx:if="{{verifyImageGenerated}}" class="btn ghost" bindtap="saveProtectedImage" style="margin-top:14rpx">保存当前保护图（可信状态以结果门禁为准）</view>
            </view>
            <button class="btn primary" disabled="{{loading}}" bindtap="verifyContent">{{loadingAction==='verify' ? '登记核验中…' : '核验已登记来源'}}</button>
            <view class="note">只有返回 <text class="code">real_checkpoint + claim_valid=true + registered_blind_verification</text> 时，核验结果才显示“可引用”；匹配与未匹配均须经过同一门禁。</view>

            <view class="privacy-box safe" style="margin-top:28rpx">以下攻击链只运行“嵌入 → 攻击模拟 → 解码”的单样本工程评估，固定禁止输出来源、合规或取证结论。</view>
            <view class="field">
              <view class="field-label">可选 · 攻击链工程评估</view>
              <view class="seg"><view wx:for="{{attacks}}" wx:key="v" class="seg-item {{attack===item.v?'active':''}}" data-v="{{item.v}}" bindtap="onSelectAttack">{{item.t}}</view></view>
            </view>
            <button class="btn ghost" disabled="{{loading}}" bindtap="runInfer">{{loadingAction==='infer' ? '工程评估中…' : '运行单样本模型评估（不可引用）'}}</button>
            <view wx:if="{{error}}" class="status err">错误：{{error}}</view>
            <view wx:if="{{localArtifactError}}" class="status err">本地提示：{{localArtifactError}}</view>
          </view>

          <view wx:if="{{result}}" class="card" id="resultCard">
            <text class="exhibit">Exhibit 02 · Result</text>
            <view class="card-title">{{resultTitle}} <text class="badge {{verdict.cls}}" style="margin-left:8rpx">{{verdict.text}}</text></view>
            <view class="trust-strip {{claimClass}}">
              <text class="trust-mode">{{modeText}}</text>
              <text class="trust-claim">{{provenanceText}}</text>
              <text class="trust-claim">{{claimText}}</text>
              <text class="trust-claim">门禁说明：{{gateReasonText}}</text>
            </view>
            <view class="figs">
              <view class="fig" wx:for="{{imgs}}" wx:key="key"><image src="{{item.src}}" mode="aspectFill"></image><view class="cap">{{item.label}}</view></view>
            </view>
            <view wx:if="{{showMetrics}}" class="metrics">
              <view class="metric"><view class="mv {{accClass}}">{{accText}}</view><view class="mk">{{metricPrimaryLabel}}</view></view>
              <view class="metric"><view class="mv info">{{psnrText}}</view><view class="mk">{{metricSecondaryLabel}}</view></view>
            </view>
            <view class="row"><text class="k">执行模式</text><text class="badge {{modeClass}}">{{modeText}}</text></view>
            <view class="row"><text class="k">后端原始 claim_valid</text><text class="badge {{declaredClaimValid?'info':'risk'}}">{{declaredClaimValid?'true':'false / 缺失'}}</text></view>
            <view class="row"><text class="k">有效引用门禁</text><text class="badge {{claimClass}}">{{claimValid?'可引用':'不可引用'}}</text></view>
            <view class="row"><text class="k">记录 / 事件 ID</text><text class="k" style="word-break:break-all;text-align:right;max-width:65%">{{taskId || '—'}}</text></view>
            <view class="status" bindtap="toggleEvidence">{{showEvidence?'▾ 收起':'▸ 展开'}} 原始响应摘要 JSON（签名不等于司法采信）</view>
            <view wx:if="{{showEvidence}}" class="fold"><text class="code">{{evidenceText}}</text></view>
            <view style="display:flex;gap:16rpx;margin-top:16rpx">
              <view class="btn ghost" style="flex:1" bindtap="reset">重新开始</view>
              <view class="btn ghost" style="flex:1" bindtap="generatePoster">{{claimValid?'生成技术记录卡':'生成不可引用说明卡'}}</view>
            </view>
            <view wx:if="{{posterPath}}" style="margin-top:16rpx">
              <image src="{{posterPath}}" mode="widthFix" style="width:100%;border-radius:12rpx"></image>
              <view style="display:flex;gap:16rpx;margin-top:12rpx">
                <view class="btn primary" style="flex:1" bindtap="savePoster">保存到相册</view>
                <button class="btn ghost" style="flex:1" open-type="share">转发好友</button>
              </view>
            </view>
            <view class="note">{{resultNote}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 面 1 · 证据 -->
    <view class="cube-face cf1">
      <scroll-view scroll-y class="face-scroll">
        <view class="face-pad">
          <view class="brand">
            <view class="brand-mark"><image src="/assets/logo-light.png" mode="aspectFit"></image></view>
            <view><view class="brand-title">完整性审计</view><view class="brand-sub">Integrity Audit</view></view>
          </view>
          <view class="card">
            <text class="exhibit">Exhibit 31 · Signature Audit</text>
            <view class="card-title">密码学完整性审计 <text class="badge {{sigOk?'ok':'warn'}}" style="margin-left:8rpx">{{sigText}}</text></view>
            <view class="row"><text class="k">公钥指纹</text><text class="k">{{fp || '—'}}</text></view>
            <view class="row"><text class="k">审计阻断</text><text class="badge {{blocking===0?'ok':'risk'}}">{{blocking}} 项</text></view>
            <view class="row"><text class="k">声明门禁就绪</text><text class="badge {{claimsReady?'ok':'risk'}}">{{claimsReady?'是':'否'}}</text></view>
            <view wx:if="{{auditErr}}" class="status err">错误：{{auditErr}}</view>
            <view class="note">验签用于检查记录完整性与签名身份；不自动构成司法证据、监管认定或平台合规结论。</view>
          </view>

          <view class="card">
            <text class="exhibit">Exhibit 12 · Batch Compliance</text>
            <view class="card-title">平台合规能力门禁（当前不可判定）</view>
            <view class="card-desc">当前后端只支持“嵌入后再解码”的模型评估，不能判断既有图片是否含水印。盲检能力上线前，本模块 fail-closed，不输出合规率。</view>
            <view class="trust-strip risk">
              <text class="trust-mode">UNAVAILABLE · 盲检能力未实现</text>
              <text class="trust-claim">CLAIM INVALID · 禁止作合规结论</text>
            </view>
            <view class="privacy-box safe">所选批量图片仅在本机预览；点击下方按钮不会上传图片。</view>
            <view class="pick" style="height:200rpx;margin-top:16rpx" bindtap="cChoose">
              <text class="plus" style="font-size:52rpx">＋</text>
              <text class="hint">{{cFiles.length ? '已选 '+cFiles.length+' 张，点此重选' : '从相册多选图片'}}</text>
            </view>
            <view wx:if="{{cFiles.length}}" class="hist-grid" style="margin-top:16rpx">
              <view wx:for="{{cFiles}}" wx:key="*this" class="fig" style="width:calc(33.3% - 11rpx)"><image src="{{item}}" mode="aspectFill" style="height:160rpx"></image></view>
            </view>
            <view class="field" style="margin-top:16rpx">
              <view class="seg">
                <view class="seg-item {{cModel==='SepMark'?'active':''}}" data-v="SepMark" bindtap="cSelModel">SepMark</view>
                <view class="seg-item {{cModel==='WaveGuard'?'active':''}}" data-v="WaveGuard" bindtap="cSelModel">WaveGuard</view>
              </view>
            </view>
            <button class="btn ghost" disabled="{{cLoading}}" bindtap="cRun">检查当前能力（不上传）</button>
            <view wx:if="{{cSum}}" class="metrics" style="margin-top:18rpx">
              <view class="metric"><view class="mv risk">{{cSum.rate}}</view><view class="mk">合规率（未计算）</view></view>
              <view class="metric"><view class="mv muted">{{cSum.total}}</view><view class="mk">总数</view></view>
            </view>
            <view wx:if="{{cSum}}" class="trust-strip risk"><text class="trust-mode">{{cSum.modeText}}</text><text class="trust-claim">{{cSum.claimText}} · {{cSum.unavailable}} 张未评估</text></view>
            <view wx:if="{{cRows.length}}" class="hist-grid" style="margin-top:12rpx">
              <view wx:for="{{cRows}}" wx:key="src" class="hist-item" style="width:calc(33.3% - 11rpx)">
                <image src="{{item.src}}" mode="aspectFill" style="height:150rpx"></image>
                <view class="hist-meta"><view class="l1"><text class="badge {{item.cls}}">{{item.label}}</text></view><view class="l2">{{item.accText}}</view></view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 面 2 · 我的 -->
    <view class="cube-face cf2">
      <scroll-view scroll-y class="face-scroll">
        <view class="face-pad">
          <view class="profile-hero">
            <button class="avatar avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"><image src="{{user.avatar || '/assets/logo-light.png'}}" mode="aspectFit"></image></button>
            <view style="flex:1">
              <input wx:if="{{editing}}" class="profile-name" type="nickname" placeholder="填写昵称" value="{{user.nick}}" bindblur="onNick" bindconfirm="onNick" focus="{{true}}"></input>
              <view wx:else class="profile-name" bindtap="startEdit">{{user.nick || '寻源路用户'}} <text style="font-size:22rpx;color:var(--ink-3)">✎</text></view>
              <view class="profile-sub">本地任务记录 {{list.length}} 条</view>
            </view>
          </view>
          <view class="card">
            <text class="exhibit">History · 本地任务历史</text>
            <view class="card-title">保护、核验与评估记录</view>
            <view class="card-desc">缩略图与展示元数据仅保存在本机；历史记录会重新执行可信门禁，缺少 mode、claim_valid 或 result_provenance 的旧记录一律不可引用。</view>
            <view wx:if="{{list.length}}" class="hist-grid" style="margin-top:20rpx">
              <view wx:for="{{list}}" wx:key="t" class="hist-item">
                <image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill"></image>
                <view class="hist-meta">
                  <view class="l1"><text>{{item.model}}</text><text class="badge {{item.verdictCls}}">{{item.verdictText}}</text></view>
                  <view class="l2">{{item.scenarioText}} · 模型指标 {{item.accText}}</view>
                  <view class="l2">{{item.modeText}}</view>
                  <view class="l2">{{item.provenanceText}}</view>
                  <view class="l2">后端 claim_valid={{item.declaredClaimValid?'true':'false / 缺失'}}</view>
                  <view class="l2">{{item.claimText}}</view>
                  <view wx:if="{{item.contentIdText}}" class="l2">ID {{item.contentIdText}}</view>
                  <view class="l2">{{item.timeText}}</view>
                </view>
              </view>
            </view>
            <view wx:else class="empty">还没有本地任务记录，去「保护」创建一条吧</view>
            <view wx:if="{{list.length}}" class="btn ghost" bindtap="clearHistory" style="margin-top:22rpx">清空历史</view>
          </view>
          <view class="card">
            <text class="exhibit">More · 更多</text>
            <view class="list-item" bindtap="goMea"><image class="li-ic" src="/assets/ic-mea.png"></image><text class="li-tx">MEA 多模型横评</text><text class="li-ar">›</text></view>
            <view class="list-item" bindtap="goCompliance"><image class="li-ic" src="/assets/ic-compliance.png"></image><text class="li-tx">平台合规能力门禁</text><text class="li-ar">›</text></view>
            <view class="list-item" data-i="3" bindtap="switchFace"><image class="li-ic" src="/assets/tab-about-on.png"></image><text class="li-tx">关于寻源路</text><text class="li-ar">›</text></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 面 3 · 关于 -->
    <view class="cube-face cf3">
      <scroll-view scroll-y class="face-scroll">
        <view class="face-pad">
          <view class="brand">
            <view class="brand-mark"><image src="/assets/logo-light.png" mode="aspectFit"></image></view>
            <view><view class="brand-title">寻源路</view><view class="brand-sub">About</view></view>
          </view>
          <view style="text-align:center;margin:6rpx 0 26rpx"><image src="/assets/logo-light.png" mode="aspectFit" style="width:220rpx;height:220rpx"></image></view>
          <view class="card">
            <text class="exhibit">Positioning</text>
            <view class="card-title">让已登记内容拥有可核验的技术来源记录</view>
            <view class="card-desc">面向 AIGC / 深度伪造图像的主动水印研究与竞赛演示：发布前创建来源保护登记，传播后凭 content_id 执行登记核验。可引用状态仅由 mode、claim_valid 与场景对应 result_provenance 的三元门禁决定；鲁棒性以正式基准报告为准，签名记录不自动等同法律或监管结论。</view>
          </view>
          <view class="card">
            <text class="exhibit">《AI 内容标识办法》技术对应探索（非合规认定）</text>
            <view wx:for="{{regs}}" wx:key="c" class="row"><text class="badge info">{{item.c}}</text><text class="k" style="flex:1;text-align:right">{{item.d}}</text></view>
          </view>
          <view class="card">
            <text class="exhibit">四个第三方模型 · 项目协议与系统集成</text>
            <view wx:for="{{wmModels}}" wx:key="n" style="margin:14rpx 0">
              <view style="display:flex;align-items:center;gap:10rpx"><text class="card-title" style="margin:0">{{item.n}}</text><text wx:if="{{item.t}}" class="badge ok">{{item.t}}</text></view>
              <view class="card-desc">{{item.d}}</view>
            </view>
          </view>
          <view class="note">新疆大学 VPSG 实验室 · 全国大学生信息安全竞赛作品赛 · 技术演示作品</view>
        </view>
      </scroll-view>
    </view>

  </view>
</view>

<!-- 底部立方体导航 -->
<view class="cube-nav">
  <view class="navcube">
    <view class="ncube" style="transform: translateZ(-28rpx) rotateY({{rot}}deg)">
      <view class="ncf nf0"><image src="/assets/tab-forensics-on.png"></image></view>
      <view class="ncf nf1"><image src="/assets/tab-evidence-on.png"></image></view>
      <view class="ncf nf2"><image src="/assets/tab-profile-on.png"></image></view>
      <view class="ncf nf3"><image src="/assets/tab-about-on.png"></image></view>
    </view>
  </view>
  <view wx:for="{{navs}}" wx:key="k" class="cn-item {{rotIdx===index?'on':''}}" data-i="{{index}}" bindtap="switchFace">
    <image src="{{rotIdx===index?item.on:item.ic}}"></image>
    <text>{{item.k}}</text>
  </view>
</view>

<tapfx id="tapfx"></tapfx>
<canvas type="2d" id="posterCanvas" style="position:fixed;left:-2000px;top:0;width:300px;height:460px"></canvas>
