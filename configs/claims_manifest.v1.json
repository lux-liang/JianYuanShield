    "forbidden_document_patterns": [
      {
        "id": "legacy_performance_numbers",
        "pattern": "(?:99\\.9[78]|99\\.8|91\\.2|87\\.7|49\\.6|50\\.4|37\\.3)\\s*%|13[,.]?233|1[,.]?536|2[,.]?048",
        "reason": "Historical performance numbers are blocked until repository evidence is publishable."
      },
      {
        "id": "unsupported_superlatives",
        "pattern": "全球首个|填补空白|完整符合|完全符合|司法级证据链|等价区块链|CVPR\\s*2026|KBS\\s*2025",
        "reason": "Absolute novelty, legal-effect and venue claims require external evidence."
      },
      {
        "id": "stale_claim_gate_state",
        "pattern": "ready_for_(?:claims|demo)\\s*[:=]\\s*(?:yes|true)",
        "reason": "Documentation must not hard-code a positive runtime gate state."
      },
      {
        "id": "unsupported_checkpoint_diagnosis",
        "pattern": "HiDDeN[^\\n]{0,40}(?:checkpoint[^\\n]{0,20})?(?:根本损坏|确认损坏|训练发散)",
        "reason": "Root-cause diagnosis is not publishable without a tracked diagnostic bundle."
      }
    ]
