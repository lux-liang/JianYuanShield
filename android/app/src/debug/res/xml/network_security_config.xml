<?xml version="1.0" encoding="utf-8"?>
<!--
  调试构建专用:允许任意明文 HTTP,方便用局域网 / 公网 http 地址在真机上联调。
  这个文件只在 debug 构建生效,不会进入 release(release 用 src/main 的严格配置)。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
