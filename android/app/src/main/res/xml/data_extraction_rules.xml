<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="." />
        <exclude
            domain="sharedpref"
            path="jys_creator_identity_secure.xml" />
        <!-- No file-domain include: DataStore is excluded. -->
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="." />
        <exclude
            domain="sharedpref"
            path="jys_creator_identity_secure.xml" />
        <!-- No file-domain include: DataStore is excluded. -->
    </device-transfer>
</data-extraction-rules>
