<?xml version="1.0" encoding="utf-8"?>
<!-- Release/main 禁止所有明文 HTTP；正式服务必须使用 HTTPS。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
